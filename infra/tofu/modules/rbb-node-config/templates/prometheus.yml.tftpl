# Gerado pela infra RBB (OpenTofu), conforme o modelo do repositório rbb-monitoracao.
# Os alvos ficam em arquivos file_sd (targets/*.json) e podem ser atualizados sem
# reiniciar o Prometheus (rbb-node prometheus federation <arquivo>).
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Job para coleta das métricas locais (nós Besu desta organização).
  - job_name: rbb
    file_sd_configs:
      - files: ["/etc/prometheus/targets/local.json"]

  # Job para coletar as métricas de outras organizações (Prometheus expostos via NGINX mTLS, porta 8443).
  - job_name: rbb-federado
    honor_labels: false
    metrics_path: /federate
    scheme: https
    tls_config:
      cert_file: /etc/prometheus/certs/certificado.pem
      key_file: /etc/prometheus/certs/chave-privada.key
      insecure_skip_verify: true
    params:
      "match[]":
        - '{job="rbb"}'
    file_sd_configs:
      - files: ["/etc/prometheus/targets/federation.json"]
    metric_relabel_configs:
      # O "up" dos nós do parceiro (gerado pelo Prometheus dele) chegaria com job=rbb-federado e se
      # confundiria com o nosso "up" do alvo federado nas regras; descarta só o remoto (o nosso é sintético).
      - source_labels: ["__name__"]
        regex: "up"
        action: "drop"
      - source_labels: ["exported_instance"]
        target_label: "instance"
      - source_labels: ["exported_organization"]
        target_label: "organization"
      - action: "labeldrop"
        regex: "^exported_.*"

  # Sondas (blackbox) sobre os mesmos alvos federados: separam "firewall fechado" de "certificado
  # não instalado". O rótulo instance fica igual ao do job rbb-federado (ip:8443) para cruzar nas regras.
  - job_name: federation-port
    metrics_path: /probe
    params:
      module: [tcp_connect]
    file_sd_configs:
      - files: ["/etc/prometheus/targets/federation.json"]
    relabel_configs:
      - source_labels: ["__address__"]
        target_label: "__param_target"
      - source_labels: ["__address__"]
        target_label: "instance"
      - target_label: "__address__"
        replacement: "blackbox:9115"

  - job_name: federation-tls
    metrics_path: /probe
    params:
      module: [federation_https]
    file_sd_configs:
      - files: ["/etc/prometheus/targets/federation.json"]
    relabel_configs:
      - source_labels: ["__address__"]
        target_label: "instance"
      - source_labels: ["__address__"]
        regex: "(.*)"
        target_label: "__param_target"
        replacement: "https://$1/federate?match[]=up"
      - target_label: "__address__"
        replacement: "blackbox:9115"
