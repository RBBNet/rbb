# Gerado pela infra RBB (OpenTofu). Baseado no modelo do repositório rbb-monitoracao.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/rules-blockchain.yml
  - /etc/prometheus/rules/rules-rbb.yml
%{ if rbb_network == "lab" ~}
  - /etc/prometheus/rules/rules-rbb-lab.yml
%{ endif ~}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Job para coleta das métricas locais (nós Besu desta organização).
  - job_name: rbb
    static_configs:
%{ for t in targets ~}
      - targets: ["${t.ip}:${t.port}"]
        labels:
          node: "${t.name}"
          organization: "${organization}"
          network: "rbb${rbb_network == "lab" ? "-lab" : ""}"
%{ endfor ~}

  # Job para coletar as métricas de outras organizações (Prometheus expostos via NGINX mTLS).
  - job_name: rbb-federado
    scheme: https
    honor_labels: true
    metrics_path: /federate
    params:
      "match[]":
        - '{job="rbb"}'
    tls_config:
      cert_file: /etc/prometheus/certs/certificado.pem
      key_file: /etc/prometheus/certs/chave-privada.key
      insecure_skip_verify: true
    static_configs:
%{ for f in federation ~}
      - targets: ["${f.target}"]
        labels:
          organization: "${f.organization}"
%{ endfor ~}
%{ if length(federation) == 0 ~}
      []
%{ endif ~}
