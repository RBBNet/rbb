# Copie para terraform.tfvars. Credenciais AWS via ambiente (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
aws_account_id   = "123456789012"
aws_region       = "sa-east-1"
organization     = "exemplo"
admin_iam_users  = ["admin1", "admin2"]
signer_iam_users = ["operador"] # operação técnica (lab); em produção, o papel/usuário do serviço automatizado
