# Estado remoto no Object Storage da Magalu (compatível com S3).
# 1) Crie um bucket (ex.: tofu-state-rbb) e um par de chaves de Object Storage.
# 2) Renomeie este arquivo para backend.tf e informe as credenciais via -backend-config
#    ou variáveis de ambiente AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# 3) tofu init -migrate-state
terraform {
  backend "s3" {
    bucket = "tofu-state-rbb"
    key    = "rbb/testnet/terraform.tfstate"
    region = "br-se1"

    skip_region_validation      = true
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
    use_path_style              = true

    endpoints = {
      s3 = "https://br-se1.magaluobjects.com/"
    }
  }
}
